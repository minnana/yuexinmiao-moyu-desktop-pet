<Window x:Class="YueXinCat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="月薪喵" Width="500" Height="310"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#6B4E5C" />
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFFDFD" />
            <Setter Property="BorderBrush" Value="#F0E4E7" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#F1FBF7" />
            <Setter Property="BorderBrush" Value="#D9F0E7" />
            <Setter Property="Foreground" Value="#32745F" />
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="Transparent">
        <Canvas x:Name="PetCanvas" Background="Transparent">
            <Image x:Name="NormalCatImage" Width="214" Height="230" Canvas.Left="54" Canvas.Top="92"
                   Source="/assets/monthly_cat_normal.png" Stretch="Uniform" RenderTransformOrigin="0.5,0.85"
                   MouseLeftButtonDown="Pet_MouseLeftButtonDown" MouseMove="Pet_MouseMove" MouseLeftButtonUp="Pet_MouseLeftButtonUp" />
            <Image x:Name="KeyboardRaisedImage" Width="285" Height="237" Canvas.Left="20" Canvas.Top="66"
                   Source="/assets/monthly_cat_keyboard_raised.png" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.9"
                   MouseLeftButtonDown="Pet_MouseLeftButtonDown" MouseMove="Pet_MouseMove" MouseLeftButtonUp="Pet_MouseLeftButtonUp" />
            <Image x:Name="KeyboardDownImage" Width="285" Height="237" Canvas.Left="20" Canvas.Top="66"
                   Source="/assets/monthly_cat_keyboard_down.png" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.9"
                   MouseLeftButtonDown="Pet_MouseLeftButtonDown" MouseMove="Pet_MouseMove" MouseLeftButtonUp="Pet_MouseLeftButtonUp" />
            <Canvas x:Name="KeyboardKeyOverlay" Width="285" Height="237" Canvas.Left="20" Canvas.Top="66"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="KeyboardHighlight" Width="25" Height="15" CornerRadius="5"
                        Background="#B7F0D2" BorderBrush="#57BF91" BorderThickness="1" Visibility="Collapsed" />
                <Border x:Name="ActiveKeyBadge" Width="36" Height="32" Canvas.Left="120" Canvas.Top="101"
                        CornerRadius="10" Background="#FFFDFD" BorderBrush="#C9BCE2" BorderThickness="1"
                        Visibility="Collapsed" Opacity="0.96">
                    <TextBlock x:Name="ActiveKeyText" Text="A" Foreground="#746187" FontSize="16"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Canvas>

            <Border x:Name="InfoBubble" Width="252" MinHeight="166" Canvas.Left="214" Canvas.Top="77"
                    Background="#FFFDFD" BorderBrush="#F0E4E7" BorderThickness="1" CornerRadius="18"
                    Padding="15,13" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Ellipse Width="7" Height="7" Fill="#6ED8B2" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="工作中，也在赚" FontSize="11" Foreground="#32745F" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="×" ToolTip="退出月薪喵" Click="Close_Click" Margin="0,0,5,0" />
                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="⚙" ToolTip="收入与排班设置" Click="Settings_Click" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="我的余额" FontSize="11" Foreground="#8D7E85" Margin="0,9,0,0" />
                    <TextBlock x:Name="BalanceText" Text="−¥1,280.50" FontSize="28" FontWeight="SemiBold" Foreground="#D96D7F" Margin="0,1,0,3" />
                    <Border Height="1" Background="#EADFE5" Margin="0,1,0,9" />
                    <TextBlock x:Name="RateText" Text="摸鱼每秒  +¥0.018116" FontSize="12" Foreground="#32745F" />
                    <StackPanel x:Name="KeyboardPanel" Visibility="Collapsed" Margin="0,9,0,0">
                        <Border Height="1" Background="#EADFE5" Margin="0,0,0,8" />
                        <DockPanel>
                            <TextBlock Text="最近按键" FontSize="11" Foreground="#8D7E85" />
                            <Border x:Name="KeyCap" DockPanel.Dock="Right" MinWidth="32" Height="24" Background="#F2EDF2" CornerRadius="7" Padding="7,2">
                                <TextBlock x:Name="LastKeyText" Text="待机" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                        </DockPanel>
                        <TextBlock Text="按什么键，月薪喵就敲什么键" FontSize="10" Foreground="#8D7E85" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button x:Name="KeyboardToggleButton" Style="{StaticResource PillButton}" Content="⌨  键盘跟随" HorizontalAlignment="Left" Margin="0,11,0,0" Click="KeyboardToggle_Click" />
                </StackPanel>
            </Border>
            <Border x:Name="FloatingIncome" Canvas.Left="78" Canvas.Top="56" Background="#FFFDFD" CornerRadius="8" Padding="7,3" Visibility="Collapsed" Opacity="0.98">
                <TextBlock x:Name="FloatingIncomeText" Text="+¥0.018116" FontSize="11" Foreground="#32745F" FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="DragHint" Text="拖动月薪喵移动 · 点击齿轮设置" Canvas.Left="38" Canvas.Top="281" Foreground="#8D7E85" FontSize="10" />
        </Canvas>
    </Grid>
</Window>
